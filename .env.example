# Copy this file to .env and fill in the blank values (API keys below).
# .env is gitignored -- never commit real secrets into this file itself.

# --- Database ---
# DATABASE_URL must point at the same Postgres these three credentials spin
# up via `docker compose up -d` (docker-compose.yml reads POSTGRES_USER/
# POSTGRES_PASSWORD/POSTGRES_DB from this .env at the repo root). Defaults
# below work out of the box for local dev -- no need to change them unless
# you're pointing at something else (e.g. Neon in production).
DATABASE_URL=postgresql://raguser:1234@localhost:5432/ragdocqa
POSTGRES_USER=raguser
POSTGRES_PASSWORD=1234
POSTGRES_DB=ragdocqa

# --- Embeddings (required) ---
# Voyage AI. Used for all embedding calls (ingestion + query). Not swappable
# by design -- see CLAUDE.md's "Hard constraints" section.
VOYAGE_API_KEY=

# --- LLM provider ---
# gemini (default) has an ongoing daily free tier; anthropic is paid after a
# one-time signup credit. See CLAUDE.md's "Stack" section for the reasoning.
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Only read if LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Required in addition to ANTHROPIC_API_KEY when LLM_PROVIDER=anthropic, or
# get_llm() raises -- a deliberate guard against an accidental billed call.
# Deploy environments should never set this. Uncomment for local dev only:
# ALLOW_PAID_LLM=1

# --- Chunking strategy ---
# fixed_v1 | semantic_v1 | structure_v1 -- structure_v1 is the production
# default (see README's eval table). get_chunker(name) supports all three
# regardless of this setting; this only controls ingestion's and retrieval's
# default when no explicit override is passed.
CHUNKING_STRATEGY=structure_v1

# --- Chunking strategy tuning (optional) ---
# Defaults shown are what the code falls back to if these are unset --
# uncomment only if you're deliberately experimenting with chunk sizing.
# FIXED_CHUNK_SIZE=500
# FIXED_CHUNK_OVERLAP=50
# SEMANTIC_PERCENTILE=75.0
# SEMANTIC_MIN_CHARS=200
# SEMANTIC_MAX_CHARS=1200
# STRUCTURE_MIN_CHARS=200
# STRUCTURE_MAX_CHARS=1200
